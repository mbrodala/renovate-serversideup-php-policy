{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "serversideup/php: split tags into PHP major/minor/patch, image patch version as build",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["serversideup/php"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-(?<compatibility>[a-z0-9.-]+)\\.(?<build>\\d+)$",
      "extends": [":separatePatchReleases"]
    },
    {
      "description": "serversideup/php: PHP major/minor updates only appear in the Dependency Dashboard, no branch/MR until approved there",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["serversideup/php"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    }
  ]
}
