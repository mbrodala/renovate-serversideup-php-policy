{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "serversideup/php: PHP major/minor updates only appear in the Dependency Dashboard, no branch/MR until approved there",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["serversideup/php"],
      "extends": [
        ":separateMultipleMajorReleases",
        ":separateMultipleMinorReleases",
        ":separatePatchReleases",
        ":dependencyDashboardApproval"
      ]
    }
  ]
}
