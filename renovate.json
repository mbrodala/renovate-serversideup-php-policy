{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "serversideup/php: PHP major/minor/patch, image minor/patch as build/revision, image major + variant as compatibility",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["serversideup/php"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>.+-v\\d+)\\.(?<build>\\d+)\\.(?<revision>\\d+)$",
      "extends": [":separatePatchReleases"]
    },
    {
      "description": "serversideup/php: PHP major/minor updates only appear in the Dependency Dashboard, no branch/MR until approved there",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["serversideup/php"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    }
  ]
}
